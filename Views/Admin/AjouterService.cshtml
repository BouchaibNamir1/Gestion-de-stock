@model Gestion_de_stock.Models.Service
@{
    ViewData["Title"] = "Ajouter un Service";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-dashboard">
    <h2 class="text-center fw-bold mb-4">Ajouter un nouveau service</h2>
    <div class="card shadow-sm p-4">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Nom" class="form-label fw-bold">Nom du service</label>
                <input asp-for="Nom" class="form-control" required />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Prix" class="form-label fw-bold">Prix (€)</label>
                <input asp-for="Prix" type="number" step="0.01" class="form-control" required />
                <span asp-validation-for="Prix" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary fw-bold">Ajouter</button>
            <a href="/Admin/Services" class="btn btn-secondary">Annuler</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
