@model List<Gestion_de_stock.Models.Service>
@{
    ViewData["Title"] = "Services";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .info-section {
        background-color: #f8fbff;
        border: 1px solid #dce7f5;
        border-radius: 10px;
        padding: 1.5rem;
        margin-top: 2rem;
        text-align: center;
        box-shadow: 0 0 10px rgba(0, 51, 102, 0.1);
        color: #003366;
    }

        .info-section i {
            font-size: 2.5rem;
            color: #003366;
            margin-bottom: 0.5rem;
        }

        .info-section p {
            margin-top: 0.5rem;
            font-size: 1.1rem;
        }
</style>

<div class="container-dashboard">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="display-5 fw-bold m-0">Gestion des Services</h2>
        <a class="btn btn-primary fw-bold" href="/Admin/AjouterService">
            <i class="bi bi-plus-circle"></i> Ajouter un service
        </a>
    </div>

    <table class="table table-bordered table-hover bg-white text-dark shadow-sm">
        <thead class="table-primary">
            <tr>
                <th>Nom</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr>
                    <td>@service.Nom</td>
                    <td>@service.Description</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary me-2" href="/Admin/EditService/@service.Id">
                            <i class="bi bi-pencil-fill"></i> Modifier
                        </a>
                        <a class="btn btn-sm btn-outline-danger" href="/Admin/DeleteService/@service.Id">
                            <i class="bi bi-trash-fill"></i> Supprimer
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Bloc d'information -->
    <div class="info-section">
        <i class="bi bi-gear-fill"></i>
        <p>
            Cette section vous permet de gérer l'ensemble des services proposés par la clinique.
            Vous pouvez ajouter, modifier ou supprimer un service à tout moment.
        </p>
    </div>
</div>
