@model List<Gestion_de_stock.Models.Demande>

@{
    ViewData["Title"] = "Demandes des Cliniques";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .info-section {
        background-color: #f8fbff;
        border: 1px solid #dce7f5;
        border-radius: 10px;
        padding: 1.5rem;
        margin-top: 2rem;
        text-align: center;
        box-shadow: 0 0 10px rgba(0, 51, 102, 0.1);
        color: #003366;
    }

        .info-section i {
            font-size: 2.5rem;
            color: #003366;
            margin-bottom: 0.5rem;
        }

        .info-section p {
            margin-top: 0.5rem;
            font-size: 1.1rem;
        }
</style>

<div class="container-dashboard py-4">
    <h2 class="display-5 fw-bold mb-4 text-center">@ViewData["Title"]</h2>

    <table class="table table-bordered table-hover shadow-sm">
        <thead class="table-primary">
            <tr>
                <th>Clinique</th>
                <th>Type</th>
                <th>Description</th>
                <th>Date</th>
                <th>Statut</th>
                <th style="width: 120px;">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var demande in Model)
            {
                <tr>
                    <td>@demande.CliniqueNom</td>
                    <td>@demande.TypeDemande</td>
                    <td>@demande.Description</td>
                    <td>@demande.DateDemande.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (demande.Statut == "Non Traité")
                        {
                            <span class="badge bg-danger">@demande.Statut</span>
                        }
                        else if (demande.Statut == "Traité")
                        {
                            <span class="badge bg-success">@demande.Statut</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@demande.Statut</span>
                        }
                    </td>
                    <td>
                        <a href="/Admin/TraiterDemande/@demande.Id" class="btn btn-sm btn-primary fw-bold">
                            <i class="bi bi-check2-square me-1"></i> Traiter
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Bloc d'information -->
    <div class="info-section">
        <i class="bi bi-inbox-fill"></i>
        <p>
            Cette interface vous permet de suivre et de traiter les demandes provenant des cliniques partenaires.
            Veuillez assurer un traitement rapide et adapté à chaque requête.
        </p>
    </div>
</div>
