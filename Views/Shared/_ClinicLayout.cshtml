<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Afrobiomedic</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        body, html {
            height: 100%;
            margin: 0;
            overflow: hidden;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #ffffff 0%, #f0f4f9 100%);
            color: #003366; /* bleu foncé */
        }

        aside {
            position: fixed;
            top: 0;
            left: 0;
            width: 220px;
            height: 100vh;
            overflow-y: auto;
            background-color: #e9f0fb; /* bleu très clair */
            padding-top: 1rem;
            border-right: 1px solid #c5d0e6;
            display: flex;
            flex-direction: column;
        }

            aside h4 {
                color: #003366;
                font-weight: 700;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding-left: 1rem;
                font-size: 1.4rem;
                margin-bottom: 1rem;
            }

        ul.nav {
            flex-grow: 1;
            margin-bottom: 0;
            padding-left: 0.5rem;
            display: flex;
            flex-direction: column;
        }

            ul.nav > li.nav-item {
                margin-bottom: 0.4rem;
            }

        main {
            margin-left: 220px;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background-color: #ffffff;
        }

        header {
            flex-shrink: 0;
            position: sticky;
            top: 0;
            z-index: 1020;
            background-color: #003366; /* bleu foncé */
            color: white;
            padding: 1rem 1.5rem;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            header h5 {
                margin: 0;
                font-weight: 700;
            }

            header a.btn {
                background: transparent;
                border: 2px solid white;
                color: white;
                font-weight: 700;
                border-radius: 6px;
                padding: 0.35rem 1rem;
                transition: background-color 0.3s ease, color 0.3s ease;
                text-decoration: none;
            }

                header a.btn:hover {
                    background-color: white;
                    color: #003366;
                    text-decoration: none;
                }

        section {
            flex-grow: 1;
            overflow-y: auto;
            padding: 20px;
            background-color: #f8fbff; /* très clair */
            color: #003366;
        }

        .nav-link {
            color: #003366;
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 5px;
            transition: background-color 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

            .nav-link.active, .nav-link:hover {
                background-color: #c8dafb; /* bleu très clair */
                color: #003366 !important;
                text-decoration: none;
            }

        /* Texte descriptif sous nav */
        .sidebar-description {
            font-size: 0.85rem;
            color: #003366;
            line-height: 1.4;
            background-color: rgba(255,255,255,0.5);
            border-radius: 5px;
            margin: 0.5rem 1rem 1rem 1rem;
            padding: 0.5rem;
            text-align: left;
        }

        /* Boutons Retour et Déconnexion style bleu dégradé */
        form.logout-btn, .btn-retour {
            width: 100%;
            font-weight: 700;
            color: white;
            background: linear-gradient(135deg, #003366 0%, #004080 100%);
            border: none;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            cursor: pointer;
            box-shadow: 0 0 10px #003366;
            transition: background 0.3s ease, box-shadow 0.3s ease;
            text-align: center;
            margin: 0.3rem 1rem 1rem 1rem;
        }

            form.logout-btn:hover button,
            .btn-retour:hover {
                background: linear-gradient(135deg, #002244 0%, #003366 100%);
                box-shadow: 0 0 15px #002244;
                color: white;
                text-decoration: none;
            }

            form.logout-btn button {
                background: none;
                border: none;
                width: 100%;
                font-weight: 700;
                color: inherit;
                padding: 0;
                cursor: pointer;
            }
    </style>
</head>
<body>
    <aside>
        <h4>
            <i class="bi bi-heart-pulse"></i> Clinique
        </h4>

        <ul class="nav flex-column mt-4 fs-6 px-2">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" href="/Clinique/Dashboard">
                    <i class="bi bi-speedometer2"></i> Tableau de bord
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Produits" ? "active" : "")" href="/Clinique/Produits">
                    <i class="bi bi-box"></i> Produits disponibles
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Services" ? "active" : "")" href="/Clinique/Services">
                    <i class="bi bi-gear-fill"></i> Services disponibles
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "FaireDemande" ? "active" : "")" href="/Clinique/FaireDemande">
                    <i class="bi bi-envelope-plus"></i> Nouvelle demande
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Demandes" ? "active" : "")" href="/Clinique/Demandes">
                    <i class="bi bi-list-task"></i> Suivi des demandes
                </a>
            </li>

            <!-- espace flexible pour pousser les boutons en bas -->
            <li style="flex-grow: 1;"></li>

            <!-- TEXTE descriptif -->
            <li>
                <div class="sidebar-description">
                    <strong>Clinique</strong><br />
                    • Consulter les produits disponibles<br />
                    • Faire des demandes de produits ou services<br />
                    • Suivre le traitement de ses demandes
                </div>
            </li>

            <li class="nav-item mb-2 px-2">
                <button type="button" aria-label="Retour à la page précédente" class="btn-retour" onclick="history.back()">
                    <i class="bi bi-arrow-left"></i> Retour
                </button>
            </li>

            <li class="nav-item px-2">
                <form method="post" asp-controller="Account" asp-action="Logout" onsubmit="return confirm('Voulez-vous vraiment vous déconnecter ?');" class="logout-btn">
                    <button type="submit">
                        <i class="bi bi-box-arrow-right"></i> Déconnexion
                    </button>
                </form>
            </li>
        </ul>
    </aside>

    <main>
        <header>
            <h5>@ViewData["Title"]</h5>
            <a href="/" class="btn">
                <i class="bi bi-house-fill"></i> Accueil
            </a>
        </header>

        <section>
            @RenderBody()
        </section>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
