<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Afrobiomedic Admin</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --bleu-fonce: #003366;
            --bleu-clair: #e9f0fb;
            --bleu-hover: #c8dafb;
        }

        html, body {
            height: 100%;
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #ffffff 0%, #f0f4f9 100%);
            color: var(--bleu-fonce);
            overflow: hidden;
        }

        aside {
            position: fixed;
            top: 0;
            left: 0;
            width: 230px;
            height: 100vh;
            background: var(--bleu-clair);
            border-right: 1px solid #c5d0e6;
            display: flex;
            flex-direction: column;
            padding-top: 1rem;
        }

            aside h4 {
                font-weight: 700;
                font-size: 1.4rem;
                padding-left: 1rem;
                display: flex;
                align-items: center;
                gap: .5rem;
                color: var(--bleu-fonce);
            }

        ul.nav {
            flex-grow: 1;
            overflow-y: auto;
            margin-bottom: 0;
        }

        .nav-link {
            color: var(--bleu-fonce);
            font-weight: 600;
            padding: .5rem 1rem;
            border-radius: 5px;
            display: flex;
            align-items: center;
            gap: .5rem;
            transition: background .3s;
        }

            .nav-link.active, .nav-link:hover {
                background: var(--bleu-hover);
                text-decoration: none;
            }

        .sidebar-description {
            font-size: 0.85rem;
            color: #003366;
            line-height: 1.4;
            background-color: rgba(255,255,255,0.5);
            border-radius: 5px;
            margin: 0.5rem 1rem 1rem 1rem;
            padding: 0.5rem;
            text-align: left;
        }

        form.logout-btn {
            width: 90%;
            margin: 0 auto 1.2rem auto;
        }

            form.logout-btn button {
                width: 100%;
                border: none;
                border-radius: 5px;
                background: var(--bleu-fonce);
                color: #fff;
                font-weight: 700;
                padding: .5rem;
                transition: background .3s;
                cursor: pointer;
            }

                form.logout-btn button:hover {
                    background: #001f4d;
                }

        main {
            margin-left: 230px;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background: #fff;
        }

        header {
            flex-shrink: 0;
            position: sticky;
            top: 0;
            z-index: 1020;
            background: var(--bleu-fonce);
            color: #fff;
            padding: 1rem 1.5rem;
            box-shadow: 0 2px 5px rgb(0 0 0 / .1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            header h5 {
                margin: 0;
                font-weight: 700;
            }

            header a.btn-home {
                background: transparent;
                border: 2px solid #fff;
                color: #fff;
                font-weight: 700;
                border-radius: 6px;
                padding: .35rem 1rem;
                transition: background .3s, color .3s;
                text-decoration: none;
            }

                header a.btn-home:hover {
                    background: #fff;
                    color: var(--bleu-fonce);
                }

        section {
            flex-grow: 1;
            overflow-y: auto;
            padding: 20px;
            background: #f8fbff;
            color: var(--bleu-fonce);
        }
    </style>
</head>
<body>
    <!-- ---------- Sidebar ---------- -->
    <aside>
        <h4><i class="bi bi-shield-lock"></i> Admin</h4>

        <ul class="nav flex-column fs-6 px-2">
            <li class="nav-item mb-1">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" href="/Admin/Dashboard">
                    <i class="bi bi-speedometer2"></i> Tableau de bord
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Produits" ? "active" : "")" href="/Admin/Produits">
                    <i class="bi bi-box"></i> Produits
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Services" ? "active" : "")" href="/Admin/Services">
                    <i class="bi bi-gear-fill"></i> Services
                </a>
            </li>
            <li class="nav-item mb-1">
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Demandes" ? "active" : "")" href="/Admin/Demandes">
                    <i class="bi bi-inbox-fill"></i> Demandes
                </a>
            </li>
        </ul>

        <!-- TEXTE AU-DESSUS DU BOUTON RETOUR -->
        <div class="sidebar-description">
            <strong>Administrateur</strong><br />
            • Gérer les produits et services<br />
            • Voir et traiter les demandes des cliniques<br />
            • Superviser les stocks et les réservations
        </div>

        <!-- Bouton Retour -->
        <form method="get" action="javascript:history.back()" class="logout-btn mb-3">
            <button type="submit">
                <i class="bi bi-arrow-left-circle me-1"></i> Retour
            </button>
        </form>

        <!-- Bouton Déconnexion -->
        <form method="post" asp-controller="Account" asp-action="Logout"
              onsubmit="return confirm('Voulez-vous vraiment vous déconnecter ?');"
              class="logout-btn">
            <button type="submit">
                <i class="bi bi-box-arrow-right me-1"></i> Déconnexion
            </button>
        </form>
    </aside>

    <!-- ---------- Contenu principal ---------- -->
    <main>
        <header>
            <h5>@ViewData["Title"]</h5>
            <a href="/" class="btn-home"><i class="bi bi-house-fill me-1"></i>Accueil</a>
        </header>

        <section>
            @RenderBody()
        </section>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
