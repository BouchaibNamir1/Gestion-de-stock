@{
    ViewData["Title"] = "Créer un compte";
    Layout = null; // Pas de layout global
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Créer un compte - Afrobiomedic</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #f9fbfc 0%, #dfe7f3 100%);
            color: #003366;
            position: relative;
        }

        /* Sidebar claire avec dégradé léger bleu */
        nav.sidebar {
            background: linear-gradient(180deg, #e0e7f1 0%, #c5cee0 100%);
            min-height: 100vh;
            width: 220px;
            padding-top: 20px;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 5;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 2px 0 5px rgb(0 0 0 / 0.1);
        }

        /* Logo plus petit */
        .sidebar-logo {
            height: 40px; /* réduit */
            margin-bottom: 30px; /* plus d'espace en dessous */
            user-select: none;
        }

        /* Bouton Retour bien séparé */
        nav.sidebar form {
            width: 90%;
            margin-top: auto; /* pousse le bouton tout en bas */
            margin-bottom: 30px;
        }

            nav.sidebar form button {
                width: 100%;
                font-weight: 700;
                font-size: 1.125rem;
                color: #003366;
                border: 2px solid #003366;
                background: transparent;
                border-radius: 0.375rem;
                padding: 0.375rem 1rem;
                cursor: pointer;
                transition: background-color 0.3s, color 0.3s;
            }

                nav.sidebar form button:hover {
                    background-color: #003366;
                    color: white;
                    border-color: #003366;
                    text-decoration: none;
                }

        /* Topbar claire */
        header.topbar {
            position: fixed;
            top: 0;
            right: 0;
            left: 220px;
            height: 56px;
            background: linear-gradient(90deg, #e0e7f1 0%, #c5cee0 100%);
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 20px;
            box-shadow: 0 2px 4px rgb(0 0 0 / 0.1);
            z-index: 10;
        }

            header.topbar a.btn-accueil {
                font-weight: 700;
                font-size: 1.125rem;
                color: #003366;
                border: 2px solid #003366;
                padding: 0.375rem 1rem;
                border-radius: 0.375rem;
                transition: background-color 0.3s, color 0.3s;
                text-decoration: none;
            }

                header.topbar a.btn-accueil:hover {
                    background-color: #003366;
                    color: white;
                    border-color: #003366;
                    text-decoration: none;
                }

        /* Conteneur principal centré verticalement et horizontalement */
        main.content {
            margin-left: 220px;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            color: #003366;
        }

        /* Carte formulaire plus large */
        .card {
            background-color: white;
            border: none;
            width: 100%;
            max-width: 700px; /* plus large */
            box-shadow: 0 0 15px rgba(0,0,0,0.15);
            border-radius: 8px;
        }

        .card-header {
            background-color: #003366;
            color: #a8cdf4;
            font-weight: 700;
            font-size: 2rem;
            text-align: center;
            border-bottom: 3px solid #a8cdf4;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
            padding: 1rem;
        }

        label {
            font-weight: 600;
            color: #003366;
        }

        .btn-success {
            font-weight: 700;
            font-size: 1.1rem;
            background: linear-gradient(135deg, #003366 0%, #001f4d 100%);
            border: none;
            color: #a8cdf4;
            transition: background 0.3s ease;
            border-radius: 6px;
            padding: 0.5rem 1rem;
        }

            .btn-success:hover {
                background: linear-gradient(135deg, #001f4d 0%, #003366 100%);
                color: white;
            }

        .alert-danger p {
            margin: 0;
            color: #b20000;
        }

        p.create-account {
            text-align: center;
            margin-top: 1rem;
            font-size: 1rem;
            color: #003366;
        }

            p.create-account a {
                color: #003366;
                font-weight: 700;
                text-decoration: none;
            }

                p.create-account a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>

    <nav class="sidebar">
        <img src="/images/cropped-logo-afrobiomedic21072023.png" alt="Logo Afrobiomedic" class="sidebar-logo" />
        <form method="post" asp-controller="Account" asp-action="Logout">
            <button type="submit">Retour</button>
        </form>
    </nav>

    <header class="topbar">
        <a href="/" class="btn-accueil">Accueil</a>
    </header>

    <main class="content">
        <div class="card shadow-lg">
            <div class="card-header">
                Créer un compte
            </div>
            <div class="card-body">
                <form method="post" asp-action="Register">
                    <div class="mb-3">
                        <label for="username">Nom d'utilisateur</label>
                        <input id="username" name="username" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="password">Mot de passe</label>
                        <input id="password" name="password" type="password" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="role">Rôle</label>
                        <select id="role" name="role" class="form-select" required>
                            <option value="Admin">Admin</option>
                            <option value="Clinique">Clinique</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success w-100">Créer</button>
                </form>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mt-3">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }
            </div>
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
