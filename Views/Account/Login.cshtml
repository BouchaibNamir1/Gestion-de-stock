@{
    Layout = null;  // Pas de layout global
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Connexion - Afrobiomedic</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #f9fbfc 0%, #dfe7f3 100%);
            color: #003366;
            position: relative;
        }

        /* Sidebar claire avec dégradé léger bleu */
        nav.sidebar {
            background: linear-gradient(180deg, #e0e7f1 0%, #c5cee0 100%);
            min-height: 100vh;
            width: 220px;
            padding-top: 20px;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 5;
            display: flex;
            flex-direction: column;
            align-items: center;
            box-shadow: 2px 0 5px rgb(0 0 0 / 0.1);
        }

        /* Logo plus petit */
        .sidebar-logo {
            height: 40px;
            margin-bottom: 30px;
            user-select: none;
        }

        /* Bouton Déconnexion bien séparé sous le logo */
        nav.sidebar form {
            width: 90%;
            margin-top: auto;
            margin-bottom: 30px;
        }

            nav.sidebar form button {
                width: 100%;
                font-weight: 700;
                font-size: 1.125rem;
                color: #003366;
                border: 2px solid #003366;
                background: transparent;
                border-radius: 0.375rem;
                padding: 0.375rem 1rem;
                cursor: pointer;
                transition: background-color 0.3s, color 0.3s;
            }

                nav.sidebar form button:hover {
                    background-color: #003366;
                    color: white;
                    border-color: #003366;
                    text-decoration: none;
                }

        /* Topbar claire */
        header.topbar {
            position: fixed;
            top: 0;
            right: 0;
            left: 220px;
            height: 56px;
            background: linear-gradient(90deg, #e0e7f1 0%, #c5cee0 100%);
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 0 20px;
            box-shadow: 0 2px 4px rgb(0 0 0 / 0.1);
            z-index: 10;
        }

            header.topbar a.btn-accueil {
                font-weight: 700;
                font-size: 1.125rem;
                color: #003366;
                border: 2px solid #003366;
                padding: 0.375rem 1rem;
                border-radius: 0.375rem;
                transition: background-color 0.3s, color 0.3s;
                text-decoration: none;
            }

                header.topbar a.btn-accueil:hover {
                    background-color: #003366;
                    color: white;
                    border-color: #003366;
                    text-decoration: none;
                }

        /* Conteneur principal centré verticalement et scroll si besoin */
        main.content {
            margin-left: 220px;
            min-height: 100vh;
            padding: 80px 20px 40px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #003366;
            overflow-y: auto;
        }

        /* Carte connexion */
        .card {
            background-color: white;
            border: none;
            width: 100%;
            max-width: 700px;
            box-shadow: 0 0 15px rgba(0,0,0,0.15);
            border-radius: 8px;
        }

        .card-header {
            background-color: #003366;
            color: #a8cdf4;
            font-weight: 700;
            font-size: 2rem;
            text-align: center;
            border-bottom: 3px solid #a8cdf4;
            border-top-left-radius: 8px;
            border-top-right-radius: 8px;
            padding: 1rem;
        }

        label {
            font-weight: 600;
            color: #003366;
        }

        input.form-control {
            font-size: 1rem;
        }

        /* Bouton connexion style "success" bleu */
        button.btn-warning {
            background: linear-gradient(135deg, #003366 0%, #001f4d 100%);
            border: none;
            color: #a8cdf4;
            font-weight: 700;
            font-size: 1.25rem;
            border-radius: 6px;
            padding: 0.5rem 1rem;
            width: 100%;
            transition: background 0.3s ease;
        }

            button.btn-warning:hover {
                background: linear-gradient(135deg, #001f4d 0%, #003366 100%);
                color: white;
            }

        a.text-warning {
            font-weight: 700;
            color: #003366;
        }

            a.text-warning:hover {
                text-decoration: underline;
                color: #001f4d;
            }

        .alert-danger {
            color: #b20000;
        }
    </style>
</head>
<body>

    <nav class="sidebar">
        <img src="/images/cropped-logo-afrobiomedic21072023.png" alt="Logo Afrobiomedic" class="sidebar-logo" />
        <form method="post" asp-controller="Account" asp-action="Logout">
            <button type="submit">Déconnexion</button>
        </form>
    </nav>

    <header class="topbar">
        <a href="/" class="btn-accueil">Accueil</a>
    </header>

    <main class="content">
        <div class="card shadow-lg mx-auto my-5">
            <div class="card-header">
                Connexion à Afrobiomedic
            </div>
            <div class="card-body p-5">
                <form method="post" asp-action="Login">
                    <div class="mb-4">
                        <label for="username" class="form-label">Nom d'utilisateur</label>
                        <input type="text" class="form-control form-control-lg" id="username" name="username" required />
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label">Mot de passe</label>
                        <input type="password" class="form-control form-control-lg" id="password" name="password" required />
                    </div>
                    <button type="submit" class="btn btn-warning btn-lg">Se connecter</button>
                </form>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mt-4">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <p>@error.ErrorMessage</p>
                        }
                    </div>
                }

                <p class="mt-4 text-center">
                    Pas encore de compte ?
                    <a href="/Account/Register" class="text-warning">Créer un compte</a>
                </p>
            </div>
        </div>

        <div class="w-100 mx-auto mt-4 mb-5 p-4 rounded shadow-sm" style="max-width: 800px; background: rgba(224, 231, 241, 0.8); color: #003366;">
            <h4>Accès selon votre rôle</h4>
            <hr style="border-color: #003366;" />
            <div class="row">
                <div class="col-md-6">
                    <h5>Administrateur</h5>
                    <ul>
                        <li>Gérer les produits et services</li>
                        <li>Voir et traiter les demandes des cliniques</li>
                        <li>Superviser les stocks et les réservations</li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h5>Clinique</h5>
                    <ul>
                        <li>Consulter les produits disponibles</li>
                        <li>Faire des demandes de produits ou services</li>
                        <li>Suivre le traitement de ses demandes</li>
                    </ul>
                </div>
            </div>
        </div>

    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
